<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EF Core + SQL Server. Server-only: ADA-MKII-Server is the single permitted
    consumer, which is what keeps database credentials off every client device.
    Migrations live here; run them with ADA-MKII-Server as the startup project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ADA_MKII_Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADA-MKII-Core\ADA-MKII-Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- PrivateAssets="all" so the design-time tooling never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
