<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ADA_MKII_UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ADA_MKII_UI"
    xmlns:pages="clr-namespace:ADA_MKII_UI.Pages"
    Shell.FlyoutBehavior="Disabled" HeightRequest="75">
    <ShellContent
            Title="ADA MKII"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

    <FlyoutItem Title="Settings" IsVisible="False">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate pages:Settings}" 
                          Route="Settings"/>
        </Tab>
    </FlyoutItem>

</Shell>
