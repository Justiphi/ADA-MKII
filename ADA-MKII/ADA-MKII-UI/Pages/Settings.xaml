<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ADA_MKII_UI.Pages.Settings"
             Title="Settings" >
    <VerticalStackLayout Padding="20">

        <Label
            Text="Azure API Key" 
            FontSize="Medium"/>
        <Entry
            x:Name="txtAzureAPIKey" 
            BackgroundColor="White"
            TextColor="Black"
            MinimumWidthRequest="300"
            HorizontalOptions="Start"/>

        <Label
            Text="ChatGPT API Key" 
            FontSize="Medium"/>
        <Entry
            x:Name="txtGPTAPIKey" 
            BackgroundColor="White"
            TextColor="Black"
            MinimumWidthRequest="300"
            HorizontalOptions="Start"/>

        <Label
            Text="WolfRam Alpha API Key" 
            FontSize="Medium"/>
        <Entry
            x:Name="txtWRAAPIKey" 
            BackgroundColor="White"
            TextColor="Black"
            MinimumWidthRequest="300"
            HorizontalOptions="Start"/>

        <Label
            Text="Response Engine" 
            FontSize="Medium"/>
        <StackLayout Orientation="Horizontal">
            <RadioButton x:Name="rBtnGPT" Content="ChatGPT"/>
            <RadioButton x:Name="rBtnWRA" Content="Wolfram Alpha"/>
        </StackLayout>



    </VerticalStackLayout>
</ContentPage>