<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Clear inherited/machine-level feeds so builds resolve identically on any box and in CI. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
