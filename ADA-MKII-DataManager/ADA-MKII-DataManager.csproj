<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Operator tool. Unlike the client heads, this DOES reference ADA-MKII-Data and
    holds SQL Server credentials directly - it is a second server-side process,
    not a head. That makes it the one deliberate exception to the layering rule,
    and it means this app must only ever run somewhere trusted: on the VPS, or
    over a VPN or SSH tunnel. Never install it on a shared or mobile device.

    It is also the ONLY way to create an account: the public API has no
    registration surface at all.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ADA_MKII_DataManager</RootNamespace>
    <UseWPF>true</UseWPF>
    <UserSecretsId>ada-mkii-datamanager</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ADA-MKII-Core\ADA-MKII-Core.csproj" />
    <ProjectReference Include="..\ADA-MKII-Data\ADA-MKII-Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
