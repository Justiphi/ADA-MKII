<Window x:Class="ADA_MKII_DataManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADA DataManager" Height="720" Width="1180"
        Background="#17171A" Foreground="#F2F2F3"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F2F3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#9A9AA2" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
                   FontSize="16" FontWeight="SemiBold" Foreground="#4F8CFF"
                   Text="ADA DataManager — accounts and user data" />

        <!-- Accounts and their conversations -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Accounts" FontWeight="SemiBold" Margin="0,0,12,0" />
                <Button Name="RefreshButton" Content="Refresh" Click="OnRefresh" />
            </StackPanel>

            <DataGrid Grid.Row="1" Name="AccountsGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      Background="#202024" Foreground="#F2F2F3" RowBackground="#202024"
                      AlternatingRowBackground="#26262B" GridLinesVisibility="None"
                      SelectionChanged="OnAccountSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                    <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="180" />
                    <DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="Conversations for the selected account"
                       FontWeight="SemiBold" Margin="0,12,0,6" />

            <DataGrid Grid.Row="3" Name="ConversationsGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      Background="#202024" Foreground="#F2F2F3" RowBackground="#202024"
                      AlternatingRowBackground="#26262B" GridLinesVisibility="None">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Messages" Binding="{Binding MessageCount}" Width="90" />
                    <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens}" Width="90" />
                    <DataGridTextColumn Header="Updated (UTC)" Binding="{Binding UpdatedUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Actions -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Create account">
                    <StackPanel>
                        <TextBlock Text="Username" />
                        <TextBox Name="NewUsername" />
                        <TextBlock Text="Display name" />
                        <TextBox Name="NewDisplayName" />
                        <TextBlock Text="Password" />
                        <PasswordBox Name="NewPassword" />
                        <TextBlock Text="Confirm password" />
                        <PasswordBox Name="NewPasswordConfirm" />
                        <Button Content="Create account" Click="OnCreateAccount" HorizontalAlignment="Left" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#9A9AA2"
                                   Text="This tool is the only way to create an account. The API has no registration endpoint." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Selected account">
                    <StackPanel>
                        <TextBlock Name="SelectedSummary" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="No account selected." />

                        <TextBlock Text="New password" />
                        <PasswordBox Name="ResetPassword" />
                        <Button Content="Reset password" Click="OnResetPassword" HorizontalAlignment="Left" />
                        <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Foreground="#9A9AA2"
                                   Text="Resetting a password revokes every token the account holds." />

                        <TextBlock Text="Display name" />
                        <TextBox Name="RenameBox" />
                        <Button Content="Rename" Click="OnRename" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Name="DisableButton" Content="Disable" Click="OnToggleDisabled" />
                            <Button Content="Revoke tokens" Click="OnRevokeTokens" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Danger zone">
                    <StackPanel>
                        <Button Content="Delete conversations" Click="OnDeleteConversations"
                                HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <Button Content="Delete account" Click="OnDeleteAccount" HorizontalAlignment="Left" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFB4B4"
                                   Text="Deleting an account also deletes its conversations, settings and tokens. Prefer disabling." />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#202024" Padding="8,6" Margin="0,10,0,0">
            <TextBlock Name="StatusText" Text="Starting…" Foreground="#9A9AA2" />
        </Border>
    </Grid>
</Window>
