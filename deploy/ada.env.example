# Copy to /etc/ada/ada.env, then:  chown root:root /etc/ada/ada.env && chmod 0600 /etc/ada/ada.env
#
# systemd reads this before the service starts. Double underscore is the
# separator for nested configuration keys.

# SQL Server. The container binds to loopback only (see deploy/README.md), so
# this password never crosses a network, but it is still the key to every
# conversation ADA has ever had.
ConnectionStrings__Ada=Server=127.0.0.1,1433;Database=Ada;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=True

# Provider keys. Omit OpenAI entirely and the server falls back to
# EchoLlmProvider, which is useful for a first smoke test after deploying.
Ada__OpenAI__ApiKey=

# Any OpenAI-compatible endpoint. Point this at a local model and no key is
# needed at all - Ollama, for example: http://127.0.0.1:11434/v1
# Ada__OpenAI__BaseUrl=

# Users may override the endpoint from the settings page. Turn this off if
# accounts belong to other people: the server is what makes the outbound call,
# so a user-supplied address is a request this server issues on their behalf.
# Ada__OpenAI__AllowUserBaseUrl=false
# Ada__ElevenLabs__ApiKey=
