@page "/settings"
@using ADA_MKII_Core.Abstractions
@using ADA_MKII_Core.Client
@using ADA_MKII_Core.Contracts
@using ADA_MKII_UI_Shared.Services
@using System.Net.Http
@inject VoicePreferences Voice
@inject ISettingsStore SettingsStore
@inject ISpeechToTextService Stt
@inject ITextToSpeechService Tts
@inject NavigationManager Navigation

<PageTitle>Settings — ADA</PageTitle>

<div class="settings">

    <h1>Settings</h1>

    @if (!_ready)
    {
        <p class="chat-empty">Loading…</p>
    }
    else
    {
        <section class="settings-group">
            <h2>Voice</h2>

            <label class="settings-row">
                <input type="checkbox" checked="@Voice.Enabled" @onchange="OnEnabledChangedAsync" disabled="@_saving" />
                <span>
                    <span class="settings-label">Enable voice</span>
                    <span class="settings-hint">Show the microphone, and speak replies aloud.</span>
                </span>
            </label>

            <fieldset class="settings-fieldset" disabled="@(!Voice.Enabled || _saving)">
                <legend class="settings-label">Speech engine</legend>

                <label class="settings-row">
                    <input type="radio" name="provider" checked="@Voice.UseNativeSpeech"
                           @onchange="@(() => SetProviderAsync(SpeechProviders.Native))" />
                    <span>
                        <span class="settings-label">This device <span class="settings-badge">default</span></span>
                        <span class="settings-hint">
                            Uses the platform's own speech. Free, lower latency, and audio never leaves the device.
                        </span>
                    </span>
                </label>

                <label class="settings-row">
                    <input type="radio" name="provider" checked="@(!Voice.UseNativeSpeech)"
                           @onchange="@(() => SetProviderAsync(SpeechProviders.Server))" />
                    <span>
                        <span class="settings-label">ADA server</span>
                        <span class="settings-hint">
                            Sends audio to your server for transcription. Use where a platform has no usable speech
                            engine. Costs money per minute and means your voice leaves the device.
                        </span>
                    </span>
                </label>
            </fieldset>

            <div class="settings-status">
                <p>Recognition on this device: <strong>@(Stt.IsSupported ? "available" : "not available")</strong></p>
                <p>Spoken replies on this device: <strong>@(Tts.IsSupported ? "available" : "not available")</strong></p>

                @if (!Stt.IsSupported)
                {
                    <p class="settings-warning">
                        This head has no speech recognition, so the microphone is hidden regardless of the setting above.
                        Spoken replies are unaffected.
                    </p>
                }
            </div>
        </section>

        <section class="settings-group">
            <h2>Language model</h2>

            <label class="settings-row">
                <span>
                    <span class="settings-label">Endpoint</span>
                    <span class="settings-hint">
                        Any OpenAI-compatible server — Ollama, Groq, OpenRouter. Leave blank to use whatever
                        this server was configured with. Example: <code>http://192.168.1.10:11434/v1</code>
                    </span>
                    <input class="login-input settings-input" @bind="_baseUrl" @bind:event="onchange"
                           placeholder="(server default)" inputmode="url" disabled="@_saving" />
                </span>
            </label>

            <label class="settings-row">
                <span>
                    <span class="settings-label">Model</span>
                    <span class="settings-hint">
                        Must be a name the endpoint above knows. <code>gpt-4o-mini</code> for OpenAI,
                        <code>llama3.1</code> or similar for Ollama.
                    </span>
                    <input class="login-input settings-input" @bind="_model" @bind:event="onchange"
                           placeholder="(server default)" disabled="@_saving" />
                </span>
            </label>

            <label class="settings-row">
                <input type="checkbox" checked="@_toolsEnabled" @onchange="OnToolsChanged" disabled="@_saving" />
                <span>
                    <span class="settings-label">Let ADA use tools</span>
                    <span class="settings-hint">
                        Lets ADA take notes, add calendar events and remember things for you, rather than
                        only talking about them. Turn this off if your endpoint rejects requests that offer
                        tools — some smaller servers do.
                    </span>
                </span>
            </label>

            <button type="button" class="composer-button" @onclick="SaveModelAsync" disabled="@_saving">
                Save
            </button>

            <div class="settings-status">
                <p>
                    Your API key is only ever sent to the endpoint this server was configured with. Point ADA
                    somewhere else and it connects without one — which is what a local model wants anyway.
                </p>
                @if (_modelSaved)
                {
                    <p class="settings-label">Saved. The next message uses it.</p>
                }
            </div>
        </section>

        <section class="settings-group">
            <h2>Weather</h2>

            <label class="settings-row">
                <span>
                    <span class="settings-label">Location</span>
                    <span class="settings-hint">
                        The place shown on the dashboard, and what ADA means by &quot;here&quot;.
                        Include the country when the name is ambiguous — <code>Tauranga, NZ</code>
                        rather than <code>Tauranga</code>, which also exists in Sudan.
                    </span>
                    <input class="login-input settings-input" @bind="_weatherLocation" @bind:event="onchange"
                           placeholder="Tauranga, NZ" disabled="@_saving" />
                </span>
            </label>

            <button type="button" class="composer-button" @onclick="SaveWeatherAsync" disabled="@_saving">
                Save
            </button>

            <div class="settings-status">
                @if (_weatherSaved)
                {
                    <p class="settings-label">Saved.</p>
                }
            </div>
        </section>

        @if (_error is not null)
        {
            <p class="chat-error" role="alert">@_error</p>
        }

        <button type="button" class="settings-back" @onclick="@(() => Navigation.NavigateTo("/"))">Back to chat</button>
    }
</div>

@code {
    private bool _ready;
    private bool _saving;
    private string? _error;
    private string _baseUrl = string.Empty;
    private string _model = string.Empty;
    private bool _toolsEnabled = true;
    private bool _modelSaved;
    private string _weatherLocation = string.Empty;
    private bool _weatherSaved;

    private void OnToolsChanged(ChangeEventArgs args) =>
        _toolsEnabled = args.Value is true;

    private async Task SaveWeatherAsync()
    {
        _saving = true;
        _weatherSaved = false;
        _error = null;

        try
        {
            // Blank is meaningful: it hands the choice back to the server's
            // configured default rather than storing an empty location.
            await SettingsStore.SetAsync(
                SettingKeys.WeatherLocation,
                _weatherLocation.Trim(),
                CancellationToken.None);

            _weatherSaved = true;
        }
        catch (AdaUnreachableException)
        {
            _error = "Not saved - the server did not respond.";
        }
        catch (AdaApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Voice.LoadAsync(CancellationToken.None);

            // Blank means "unset", which the server reads as its own default -
            // so an empty box is a real value here, not a missing one.
            _baseUrl = await SettingsStore.GetAsync<string>(SettingKeys.BaseUrl, CancellationToken.None) ?? string.Empty;
            _model = await SettingsStore.GetAsync<string>(SettingKeys.Model, CancellationToken.None) ?? string.Empty;

            // Absent means on: tools are the default, and a fresh account has
            // never written this key.
            var tools = await SettingsStore.GetAsync<string>(SettingKeys.ToolsEnabled, CancellationToken.None);
            _toolsEnabled = !bool.TryParse(tools, out var parsed) || parsed;

            _weatherLocation = await SettingsStore.GetAsync<string>(SettingKeys.WeatherLocation, CancellationToken.None)
                ?? string.Empty;
        }
        catch (AdaUnreachableException)
        {
            _error = "Cannot reach the ADA server, so settings could not be loaded.";
        }
        catch (AdaApiException ex)
        {
            _error = ex.IsAuthFailure
                ? "This session is no longer authorised. Sign in again."
                : "Settings could not be loaded.";
        }

        _ready = true;
    }

    private async Task OnEnabledChangedAsync(ChangeEventArgs args) =>
        await SaveAsync(() => Voice.SetEnabledAsync(args.Value is true, CancellationToken.None));

    private async Task SaveModelAsync()
    {
        // Cleared first: a rejected save must not leave the previous success
        // message sitting next to the new error.
        _modelSaved = false;
        _error = null;

        var url = _baseUrl.Trim();

        // Checked here for a useful message; the server validates again, because
        // this is a value it will act on.
        if (url.Length > 0
            && (!Uri.TryCreate(url, UriKind.Absolute, out var parsed)
                || (parsed.Scheme != Uri.UriSchemeHttp && parsed.Scheme != Uri.UriSchemeHttps)))
        {
            _error = "Enter a full http or https address, or leave it blank for the server default.";
            return;
        }

        await SaveAsync(async () =>
        {
            await SettingsStore.SetAsync(SettingKeys.BaseUrl, url, CancellationToken.None);
            await SettingsStore.SetAsync(SettingKeys.Model, _model.Trim(), CancellationToken.None);
            await SettingsStore.SetAsync(SettingKeys.ToolsEnabled, _toolsEnabled, CancellationToken.None);
            _modelSaved = true;
        });
    }

    private async Task SetProviderAsync(string provider) =>
        await SaveAsync(() => Voice.SetProviderAsync(provider, CancellationToken.None));

    /// <summary>
    /// Saves immediately rather than behind a Save button. There are few settings
    /// and each is one value; an explicit save step would only create a state
    /// where the UI and the server disagree.
    /// </summary>
    private async Task SaveAsync(Func<Task> save)
    {
        _saving = true;
        _error = null;

        try
        {
            await save();
        }
        catch (AdaUnreachableException)
        {
            _error = "Cannot reach the ADA server. The change was not saved.";
        }
        catch (AdaApiException)
        {
            _error = "The server rejected the change. It was not saved.";
        }
        finally
        {
            _saving = false;
        }
    }
}
