@page "/"
@using ADA_MKII_Core.Abstractions
@using ADA_MKII_Core.Client
@using ADA_MKII_Core.Contracts
@using ADA_MKII_UI_Shared.Models
@using System.Net.Http
@using System.Globalization
@implements IAsyncDisposable
@inject IAssistantPipeline Pipeline
@inject ISpeechToTextService Stt
@inject ITextToSpeechService Tts
@inject ADA_MKII_UI_Shared.Services.VoicePreferences VoicePrefs
@inject IServerAddressProvider Server
@inject IAuthClient Auth
@inject ADA_MKII_UI_Shared.Services.SessionState Session
@inject NavigationManager Navigation

<PageTitle>ADA</PageTitle>

@if (!_ready)
{
    @* Name the server. "Loading" tells a user nothing when the thing being
       waited on is a machine they may have forgotten to start. *@
    <p class="chat-empty">Connecting to @Server.BaseAddress.Authority…</p>
    return;
}

@if (_unreachable)
{
    <div class="chat-offline" role="alert">
        <h1>Cannot reach ADA</h1>
        <p>No response from <strong>@Server.BaseAddress</strong>.</p>
        <p class="settings-hint">
            Check the server is running and that this device can reach it.
            @if (Server.CanEdit)
            {
                <span>If the address is wrong, sign in again to change it.</span>
            }
        </p>
        <div class="chat-offline-actions">
            <button type="button" class="composer-button" @onclick="RetryAsync">Try again</button>
            @if (Server.CanEdit)
            {
                <button type="button" class="settings-back" @onclick="@(() => Navigation.NavigateTo("/login"))">
                    Change server
                </button>
            }
        </div>
    </div>
    return;
}

<div class="chat">

    <div class="chat-toolbar">
        <button type="button" class="chat-new" @onclick="NewConversation" disabled="@(_busy || _turns.Count == 0)">
            New chat
        </button>
    </div>

    <div class="chat-log" role="log" aria-live="polite">
        @if (_turns.Count == 0 && !_busy)
        {
            <p class="chat-empty">Ask ADA something to get started.</p>
        }

        @foreach (var turn in _turns)
        {
            <div class="bubble @RoleClass(turn.Role)">
                <div class="bubble-body">@turn.Content@(turn.IsStreaming ? "▋" : string.Empty)</div>
                @if (turn.TokensIn + turn.TokensOut > 0)
                {
                    <div class="bubble-meta">@turn.TokensIn in / @turn.TokensOut out</div>
                }
            </div>
        }

        @if (_error is not null)
        {
            <div class="chat-error" role="alert">@_error</div>
        }
    </div>

    <form class="composer" @onsubmit="SendAsync" @onsubmit:preventDefault>

        @* Hidden unless the platform can listen AND the user wants voice - an
           enabled setting cannot conjure an engine that is not there. *@
        @if (Stt.IsSupported && VoicePrefs.Enabled)
        {
            <button type="button"
                    class="composer-mic @(_voice == VoiceSessionState.Listening ? "listening" : string.Empty)"
                    title="@(_voice == VoiceSessionState.Listening ? "Stop listening" : "Speak")"
                    aria-label="@(_voice == VoiceSessionState.Listening ? "Stop listening" : "Speak")"
                    aria-pressed="@(_voice == VoiceSessionState.Listening)"
                    disabled="@_busy"
                    @onclick="ToggleListenAsync">
                @(_voice == VoiceSessionState.Listening ? "■" : "🎤")
            </button>
        }

        @* Enter is handled explicitly rather than relying on the form's implicit
           submission, which does not fire reliably here - and a chat UI where
           Enter does not send is broken. Shift+Enter is left free for when this
           becomes a multi-line textarea. *@
        <input class="composer-input"
               @bind="_draft"
               @bind:event="oninput"
               @onkeydown="OnKeyDownAsync"
               placeholder="Message ADA"
               aria-label="Message ADA"
               disabled="@_busy" />

        @if (_busy)
        {
            <button type="button" class="composer-button stop" @onclick="Stop">Stop</button>
        }
        else
        {
            <button type="submit" class="composer-button" disabled="@string.IsNullOrWhiteSpace(_draft)">Send</button>
        }
    </form>

</div>

@code {
    private readonly List<ChatTurn> _turns = [];

    private string _draft = string.Empty;
    private bool _busy;
    private bool _ready;
    private bool _unreachable;
    private string? _error;
    private Guid? _conversationId;
    private CancellationTokenSource? _cts;
    private CancellationTokenSource? _listenCts;
    private VoiceSessionState _voice = VoiceSessionState.Idle;

    protected override Task OnInitializedAsync() => ConnectAsync();

    private async Task RetryAsync()
    {
        _unreachable = false;
        _ready = false;
        StateHasChanged();

        await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        // A stored token may still be valid from a previous run, so ask the
        // server who we are before sending anyone to the login page.
        if (!Session.IsSignedIn)
        {
            try
            {
                var account = await Auth.GetCurrentAsync(CancellationToken.None);

                if (account is null)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }

                Session.SignedIn(account);
            }
            catch (AdaUnreachableException)
            {
                _unreachable = true;
                _ready = true;
                return;
            }
        }

        // Voice preferences decide whether the microphone appears at all, so they
        // must be loaded before the first render of the composer. A failure here
        // is not worth blocking chat over - the documented defaults stand.
        try
        {
            await VoicePrefs.LoadAsync(CancellationToken.None);
        }
        catch (AdaUnreachableException)
        {
        }

        _ready = true;
    }

    private static string RoleClass(ChatRole role) => role switch
    {
        ChatRole.User => "user",
        ChatRole.Assistant => "assistant",
        _ => "system",
    };

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            // SendAsync guards on _busy, so this cannot double-fire if the form's
            // own submit also happens to reach us.
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        var message = _draft.Trim();
        if (message.Length == 0 || _busy)
        {
            return;
        }

        _draft = string.Empty;
        _error = null;
        _busy = true;

        // Show the user's message immediately rather than waiting for the round
        // trip: the server has already been told to persist it.
        _turns.Add(new ChatTurn { Role = ChatRole.User, Content = message });

        var reply = new ChatTurn { Role = ChatRole.Assistant, IsStreaming = true };
        _turns.Add(reply);

        _cts = new CancellationTokenSource();

        try
        {
            await foreach (var evt in Pipeline.RunAsync(new ChatRequest(_conversationId, message), _cts.Token))
            {
                switch (evt.Type)
                {
                    case ChatStreamEvent.DeltaType:
                        reply.Content += evt.Text;
                        break;

                    case ChatStreamEvent.DoneType:
                        _conversationId = evt.ConversationId ?? _conversationId;
                        reply.TokensIn = evt.TokensIn ?? 0;
                        reply.TokensOut = evt.TokensOut ?? 0;
                        break;

                    case ChatStreamEvent.ErrorType:
                        _error = evt.Error;
                        break;

                    default:
                        break;
                }

                // Repaint per delta - this is what makes the reply appear to type.
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // The user pressed Stop. Keep whatever arrived; the turn is over.
        }
        catch (AdaApiException ex)
        {
            _error = ex.IsAuthFailure
                ? "This device is not authorised. Check its access token."
                : $"ADA could not respond: {ex.Message}";
        }
        catch (AdaUnreachableException)
        {
            _error = $"Lost contact with {Server.BaseAddress.Authority}. The reply may not have been saved.";
        }
        finally
        {
            reply.IsStreaming = false;

            if (reply.Content.Length == 0)
            {
                _turns.Remove(reply);
            }

            _busy = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }

        // Speak the finished reply, not the deltas - synthesising fragments as
        // they stream produces stuttering nonsense.
        if (Tts.IsSupported && VoicePrefs.Enabled && _error is null && reply.Content.Length > 0)
        {
            _voice = VoiceSessionState.Speaking;
            StateHasChanged();

            await Tts.SpeakAsync(reply.Content, CancellationToken.None);

            _voice = VoiceSessionState.Idle;
            StateHasChanged();
        }
    }

    private void Stop() => _cts?.Cancel();

    /// <summary>
    /// Push-to-talk. Deliberately not a wake word: always-on listening costs
    /// battery and false triggers, and is not worth it yet - see CLAUDE.md.
    /// </summary>
    private async Task ToggleListenAsync()
    {
        if (_voice == VoiceSessionState.Listening)
        {
            await _listenCts!.CancelAsync();
            return;
        }

        // Barge-in: never listen while speaking, or ADA hears itself.
        await Tts.StopAsync();

        if (!await Stt.RequestPermissionAsync(CancellationToken.None))
        {
            _error = "Microphone access was denied.";
            return;
        }

        _listenCts = new CancellationTokenSource();
        _voice = VoiceSessionState.Listening;
        _error = null;

        try
        {
            await foreach (var partial in Stt.ListenAsync(CultureInfo.CurrentCulture, _listenCts.Token))
            {
                // Partials replace the draft rather than append: each one is the
                // recogniser's best guess at the whole utterance so far.
                _draft = partial.Text;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // The user stopped listening.
        }
        catch (InvalidOperationException ex)
        {
            // The JS side reports unsupported browsers and denied microphones here.
            _error = ex.Message;
        }
        finally
        {
            _listenCts?.Dispose();
            _listenCts = null;
            _voice = VoiceSessionState.Idle;
            StateHasChanged();
        }

        // Send straight away when something was heard: having to reach for the
        // keyboard after speaking defeats the point.
        if (!string.IsNullOrWhiteSpace(_draft) && _error is null)
        {
            await SendAsync();
        }
    }

    /// <summary>
    /// Starts a fresh thread. Clearing the id is enough: the server creates a new
    /// conversation whenever a turn arrives without one.
    /// </summary>
    private void NewConversation()
    {
        _turns.Clear();
        _conversationId = null;
        _error = null;
    }

    public async ValueTask DisposeAsync()
    {
        // Cancel in flight work so a closed tab stops the turn server-side
        // instead of streaming tokens nobody will read.
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }
    }
}
