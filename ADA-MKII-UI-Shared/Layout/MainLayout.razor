@inherits LayoutComponentBase
@implements IDisposable
@using ADA_MKII_Core.Abstractions
@using ADA_MKII_UI_Shared.Services
@inject SessionState Session
@inject IAuthClient Auth
@inject NavigationManager Navigation
@inject ReminderSync Reminders

<div class="ada-shell">
    <header class="ada-header">
        <span class="ada-wordmark">ADA</span>

        @if (Session.IsSignedIn)
        {
            <nav class="ada-nav">
                <NavLink class="ada-nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink class="ada-nav-link" href="chat">Chat</NavLink>
                <NavLink class="ada-nav-link" href="calendar">Calendar</NavLink>
                <NavLink class="ada-nav-link" href="notes">Notes</NavLink>
                <NavLink class="ada-nav-link" href="memories">Memories</NavLink>
            </nav>

            <div class="ada-account">
                <span class="ada-account-name">@Session.Account!.DisplayName</span>
                <NavLink class="ada-signout" href="settings">Settings</NavLink>
                <button type="button" class="ada-signout" @onclick="SignOutAsync">Sign out</button>
            </div>
        }
    </header>

    <main class="ada-main">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    /// <summary>
    /// Hands upcoming reminders to the device once the app is up.
    ///
    /// Here rather than on a page because it must happen wherever the user lands,
    /// and here rather than in OnInitialized because on MAUI this is the point at
    /// which a scheduler may prompt for permission. It is throttled and does
    /// nothing at all on a head that cannot schedule, so the cost on the web is a
    /// single branch.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Session.IsSignedIn)
        {
            return;
        }

        await Reminders.SyncIfStaleAsync(CancellationToken.None);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task SignOutAsync()
    {
        await Auth.LogoutAsync(CancellationToken.None);
        Session.SignedOut();
        Navigation.NavigateTo("/login");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
