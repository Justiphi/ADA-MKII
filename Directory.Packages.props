<Project>

  <!--
    Central Package Management. Package VERSIONS live here and nowhere else;
    csproj files carry only <PackageReference Include="..." /> with no Version
    attribute. Version drift between projects is the top multi-project bug
    source - see CLAUDE.md.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core: abstractions plus the typed HTTP client SDK every head uses. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

  <!-- Outbound integrations (ADA-MKII-API) -->
  <ItemGroup>
    <PackageVersion Include="ElevenLabs-DotNet" Version="3.7.2" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
  </ItemGroup>

  <!-- Data access (ADA-MKII-Data) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
  </ItemGroup>

  <!-- Server (ADA-MKII-Server) -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Operator tool (ADA-MKII-DataManager) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <!-- Discord bot (ADA-MKII-Discord) -->
  <ItemGroup>
    <PackageVersion Include="Discord.Net" Version="3.20.1" />
  </ItemGroup>

  <!-- Shared Razor UI (ADA-MKII-UI-Shared) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

  <!-- MAUI head (ADA-MKII-UI). CommunityToolkit.Maui supplies SpeechToText in phase 5. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.90" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.0" />
    <!-- Microphone capture. The package targets net9 platform TFMs, which a net10
         platform TFM resolves against. -->
    <PackageVersion Include="Plugin.Maui.Audio" Version="4.0.0" />

    <!--
      On-device reminders. Verified to ship lib/net10.0-android36.0 and
      lib/net10.0-windows10.0.19041 - checked rather than assumed, because the
      MAUI ecosystem's .NET 10 coverage is uneven and this project has already
      been caught out once by a package that dropped an API.
    -->
    <PackageVersion Include="Plugin.LocalNotification" Version="14.1.1" />
  </ItemGroup>

  <!--
    On-device speech recognition. Whisper.net is the managed API; the Runtime
    package carries the native binaries - android-arm64-v8a/x86/x86_64 and
    win-x64/arm64/x86. Note there is NO armeabi-v7a: 32-bit ARM Android devices
    are not supported.
  -->
  <ItemGroup>
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
