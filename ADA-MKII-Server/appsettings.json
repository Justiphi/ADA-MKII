{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Ada": {
    "Auth": {
      "BootstrapTokenName": "bootstrap"
    },
    "Weather": {
      "DefaultLocation": "Tauranga, NZ",
      "ForecastDays": 5
    }
  },
  "AllowedHosts": "*"
}
